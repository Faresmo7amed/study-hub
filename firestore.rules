rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Each user can only touch their own documents, and only the ten known keys
    match /users/{uid}/data/{key} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;

      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && key in ['todos', 'activity', 'focus', 'events', 'game', 'settings', 'database', 'notes', 'labels', 'roadmap']
        && request.resource.data.keys().hasOnly(['value', 'updatedAt', 'serverAt'])
        && request.resource.data.value is string
        && request.resource.data.value.size() < 950000
        && request.resource.data.updatedAt is number
        && request.resource.data.serverAt == request.time;
    }

    // Everything else is closed
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
